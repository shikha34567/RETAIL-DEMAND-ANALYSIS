# RideIntel Frontend Environment Configuration Template
# Copy this file to .env and configure your local settings.

# Backend FastAPI Base URL (defaults to /api/v1 via Vite proxy)
VITE_API_BASE_URL=/api/v1

# Map Tiles Configuration
# You can supply EITHER:
# 1. A full Leaflet tile URL template with placeholder params {s}, {z}, {x}, {y}, {r}:
# VITE_MAP_TILES_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png?key=YOUR_CARTO_API_KEY
# 2. Or just your CARTO API key (which will automatically be combined with the official dark matter tile template):
# VITE_MAP_TILES_URL=your_carto_api_key_here
VITE_MAP_TILES_URL=your_map_tiles_key_or_url_here

